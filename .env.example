# Export these variables in your shell or process manager; .env is not loaded automatically.
OUTHMAN_BASE_URL=http://127.0.0.1:10070
OUTHMAN_APP_ID=
OUTHMAN_APP_SECRET=
CSO_HOST=127.0.0.1
PORT=10081
# Enable behind HTTPS:
CSO_SECURE_COOKIES=0
# Optional: external encryption/session/bootstrap secrets; defaults are generated in data/.
# CSO_ENCRYPTION_KEY=<Fernet key>
# CSO_SESSION_SECRET=<random long secret>
# CSO_BOOTSTRAP_TOKEN=<random invitation>

# Public origin used for Google OAuth behind a reverse proxy (no trailing path):
# CSO_PUBLIC_URL=https://cso.example.com

# Maximum file size ceiling (MiB); requests allow another 1 MiB for multipart overhead:
CSO_MAX_UPLOAD_MIB=512
