# Copy to .env and replace OuthMan values. Do not commit .env.
OUTHMAN_BASE_URL=https://YOUR-OUTHMAN-HOST
OUTHMAN_APP_ID=REPLACE_WITH_16_HEX_CHARACTERS
OUTHMAN_APP_SECRET=REPLACE_WITH_32_HEX_CHARACTERS
CSO_MAX_UPLOAD_MIB=128
CSO_SECURE_COOKIES=0
# Private LAN access; use 127.0.0.1 behind a reverse proxy or SSH tunnel.
CSO_BIND_ADDRESS=0.0.0.0
CSO_PORT=10081
# For HTTPS deployment, set public origin and CSO_SECURE_COOKIES=1.
# CSO_PUBLIC_URL=https://cso.example.com
# Override only when using a custom image tag:
# CSO_IMAGE=ghcr.io/cosinecloud/cso:latest
